@{
    ViewData["Title"] = "Семантический поиск";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="text-center mb-4">Поиск по базе знаний Нейросетей</h1>
            <div class="card p-4 shadow-sm">
                <form asp-action="Search" method="post">
                    <div class="mb-3">
                        <label for="query" class="form-label">Введите ваш вопрос:</label>
                        <input type="text" class="form-control form-control-lg" id="query" name="query" placeholder="Например: Как работает трансформер?" required>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100">Найти ответ</button>
                </form>
                <div class="mt-3 text-muted small">
                </div>
            </div>
        </div>
    </div>
</div>
